<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GameFolder Condition="Exists('$(B1_DIRECTORY)')">$(B1_DIRECTORY)</GameFolder>
        <GameFolder Condition="!Exists('$(B1_DIRECTORY)')">..\..\GameDir</GameFolder>
        <ModFolder>$(GameFolder)\b1\Binaries\Win64\CSharpLoader\Mods\$(AssemblyName)</ModFolder>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <PackageReference PrivateAssets="all" />
        <Reference Private="false" />
    </ItemDefinitionGroup>

    <ItemGroup>
        <Reference Include="B1UI_GSE.Script">
          <HintPath>..\B1CSharpLoader\GameDll\B1UI_GSE.Script.dll</HintPath>
        </Reference>
        <Reference Include="BtlSvr.Main">
            <HintPath>..\B1CSharpLoader\GameDll\BtlSvr.Main.dll</HintPath>
        </Reference>
        <Reference Include="b1.Native">
            <HintPath>..\B1CSharpLoader\GameDll\b1.Native.dll</HintPath>
        </Reference>
        <Reference Include="b1.NativePlugins">
            <HintPath>..\B1CSharpLoader\GameDll\b1.NativePlugins.dll</HintPath>
        </Reference>
        <Reference Include="GSE.Core">
            <HintPath>..\B1CSharpLoader\GameDll\GSE.Core.dll</HintPath>
        </Reference>
        <Reference Include="GSE.ProtobufDB">
            <HintPath>..\B1CSharpLoader\GameDll\GSE.ProtobufDB.dll</HintPath>
        </Reference>
        <Reference Include="Google.Protobuf">
            <HintPath>..\B1CSharpLoader\GameDll\Google.Protobuf.dll</HintPath>
        </Reference>
        <Reference Include="Protobuf.RunTime">
            <HintPath>..\B1CSharpLoader\GameDll\Protobuf.RunTime.dll</HintPath>
        </Reference>
        <Reference Include="UnrealEngine.Runtime">
            <HintPath>..\B1CSharpLoader\GameDll\UnrealEngine.Runtime.dll</HintPath>
        </Reference>
        <Reference Include="UnrealEngine">
            <HintPath>..\B1CSharpLoader\GameDll\UnrealEngine.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="B1CSharpLoader.ModBase" Version="0.1.1" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="A11y\" />
    </ItemGroup>

    <Target Name="GenerateBuildMeta" BeforeTargets="BeforeBuild">
        <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitHash" />
        </Exec>
        <Exec Command="git status --porcelain" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitDirty" />
        </Exec>
        <PropertyGroup>
            <GitHash Condition="'$(GitHash)' == ''">unknown</GitHash>
            <GitDirty Condition="'$(GitDirty)' != ''">true</GitDirty>
            <GitDirty Condition="'$(GitDirty)' == ''">false</GitDirty>
            <BuildTime>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm:ss"))</BuildTime>
            <BuildMetaCode>[assembly: System.Reflection.AssemblyMetadata("GitHash", "$(GitHash.Trim())")]
[assembly: System.Reflection.AssemblyMetadata("IsDirty", "$(GitDirty)")]
[assembly: System.Reflection.AssemblyMetadata("BuildTime", "$(BuildTime)")]</BuildMetaCode>
        </PropertyGroup>
        <WriteLinesToFile
            File="$(IntermediateOutputPath)BuildMeta.g.cs"
            Lines="$(BuildMetaCode)"
            Overwrite="true" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)BuildMeta.g.cs" />
        </ItemGroup>
    </Target>

    <Target Name="CopyToModsFolder" AfterTargets="Build" Condition="Exists('$(GameFolder)')">
        <MakeDir Directories="$(ModFolder)" Condition="!Exists('$(ModFolder)')" />
        <Copy SourceFiles="$(OutputPath)\$(AssemblyName).dll" DestinationFolder="$(ModFolder)" />
        <Message Text="Copied DLL -&gt; $(ModFolder)\$(AssemblyName).dll" Importance="High" />
    </Target>

    <Target Name="WarnInvalidGameFolder" AfterTargets="Build" Condition="!Exists('$(GameFolder)')">
        <Message Text="Warning: GameFolder is not valid, the folder does not exist on the computer" Importance="High" />
    </Target>

</Project>
